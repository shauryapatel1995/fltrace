CC = gcc
CFLAGS = -Wall -Wextra -O2 -std=c99 -g
XGBOOST_LDFLAGS = -L/usr/local/lib -lxgboost -Wl,-rpath=/usr/local/lib

# jemalloc
JEMALLOC_PATH = ./jemalloc
JEMALLOC_INC = $(shell cat $(JEMALLOC_PATH)/je_includes)
JEMALLOC_LIBS = $(shell cat $(JEMALLOC_PATH)/je_libs)
JEMALLOC_STATIC_LIBS = $(shell cat $(JEMALLOC_PATH)/je_static_libs)

CFLAGS += $(JEMALLOC_INC)
LDFLAGS = $(XGBOOST_LDFLAGS) $(JEMALLOC_STATIC_LIBS) -lpthread -lm -ldl

TARGET = xgboost_inference
SOURCE = xgboost_inference.c

# Default target
all: $(TARGET)

# Build the inference program
$(TARGET): $(SOURCE)
	@echo "Compiling XGBoost inference program..."
	$(CC) $(CFLAGS) -o $(TARGET) $(SOURCE) $(LDFLAGS)
	@echo "Build complete: $(TARGET)"

# Clean build artifacts
clean:
	@echo "Cleaning build artifacts..."
	rm -f $(TARGET)
	@echo "Clean complete"

# Install XGBoost dependencies (Ubuntu/Debian)
install-deps:
	@echo "Installing XGBoost development dependencies..."
	sudo apt-get update
	sudo apt-get install -y libxgboost-dev pkg-config
	@echo "Dependencies installed"

# Test the program with sample data
test: $(TARGET)
	@echo "Testing XGBoost inference..."
	@echo "Note: This requires a trained model file"
	@echo "Usage: ./$(TARGET) <model_path> <pc> <offset> <delta> <offset_from_faulting>"
	@echo "Example: ./$(TARGET) my_dataset_xgboost_model.json 0x50c9f0 -1 1 0"

# Help target
help:
	@echo "Available targets:"
	@echo "  all          - Build the inference program (default)"
	@echo "  clean        - Remove build artifacts"
	@echo "  install-deps - Install XGBoost development dependencies"
	@echo "  test         - Show test usage examples"
	@echo "  help         - Show this help message"
	@echo ""
	@echo "Usage after building:"
	@echo "  ./$(TARGET) <model.json> <pc> <offset> <delta> <offset_from_faulting>"

.PHONY: all clean install-deps test help